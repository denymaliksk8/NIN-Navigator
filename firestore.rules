rules_version = '2';
// NIN Navigator — aturan Firestore (Spark, tanpa Cloud Functions).
// Prinsip: hanya pengguna Anonymous Auth; dokumen laporan divalidasi ketat (jenis, koordinat, TTL maks, panjang catatan);
// anti-spam ditegakkan di server lewat dokumen users/{uid} (1 laporan / 30 dtk, maks 20 / hari); satu suara per pengguna per laporan
// (dokumen reports/{id}/votes/{uid} dibuat SATU batch dengan kenaikan penghitung); hapus hanya milik sendiri. Tidak ada data lokasi pelacakan.
//
// CATATAN: tabel TTL di bawah HARUS sama dengan TYPES di js/reports.js (dijaga tests/rules.static.test.mjs).
// Aturan create & vote memakai getAfter() → hanya bisa diuji sebagai SATU batch (Rules Playground tidak mendukung batch):
// pakai cek-firebase.html atau tests/firestore.rules.emu.test.mjs (lihat docs/FIREBASE.md).
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    // Masa berlaku awal (detik) per jenis laporan
    function ttlTable() {
      return {'police': 7200, 'accident': 7200, 'jam': 2700, 'closed': 21600, 'pothole': 604800, 'flood': 10800, 'obstacle': 7200, 'breakdown': 3600, 'weather': 10800};
    }
    // Perpanjangan per konfirmasi = ¼ TTL (ditulis eksplisit supaya selalu bilangan bulat; pembagian int/int di rules bisa menghasilkan float)
    function ttlQuarterTable() {
      return {'police': 1800, 'accident': 1800, 'jam': 675, 'closed': 5400, 'pothole': 151200, 'flood': 2700, 'obstacle': 1800, 'breakdown': 900, 'weather': 2700};
    }
    function validType(t) { return t is string && t in ttlTable().keys(); }
    function day() { return math.floor(request.time.toMillis() / 86400000); }

    // ---- profil anti-spam (hanya penghitung, bukan data pribadi) ----
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastReportAt', 'dayKey', 'dayCount'])
        && request.resource.data.keys().hasAll(['lastReportAt', 'dayKey', 'dayCount'])
        && request.resource.data.lastReportAt == request.time
        && request.resource.data.dayKey == day() && request.resource.data.dayCount == 1;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastReportAt', 'dayKey', 'dayCount'])
        && request.resource.data.keys().hasAll(['lastReportAt', 'dayKey', 'dayCount'])
        && request.resource.data.lastReportAt == request.time
        && resource.data.lastReportAt <= request.time - duration.value(30, 's')            // ≥ 30 detik antar laporan
        && request.resource.data.dayKey == day()
        && (resource.data.dayKey == day()
              ? (request.resource.data.dayCount == resource.data.dayCount + 1 && request.resource.data.dayCount <= 20)   // ≤ 20 / hari
              : request.resource.data.dayCount == 1);
      allow delete: if false;   // supaya batas laju tidak bisa direset dengan menghapus; hanya berisi penghitung anonim
    }

    // ---- lalu lintas (probe kecepatan ANONIM, Fase 5): dokumen = jendela 10 menit × sel geohash-7. Tanpa uid, tanpa koordinat.
    // id = "<bucket>_<geohash7>"; n = jumlah sampel, s = jumlah km/j; setiap penulisan hanya boleh menambah n sebanyak 1 dan s sebesar 0..200.
    // Tanpa uid, satu perangkat nakal tetap bisa menambah sampel palsu (batas: n ≤ 2000/sel) — pengamanan tambahan = App Check (docs/FIREBASE.md).
    match /traffic/{id} {
      function validTrafficId() { return id.matches('[0-9]{6,8}_[0-9b-hjkmnp-z]{7}'); }
      function trafficShape() { return request.resource.data.keys().hasOnly(['n', 's', 'exp']) && request.resource.data.keys().hasAll(['n', 's', 'exp']) && request.resource.data.s is int && request.resource.data.exp is timestamp; }
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 300;
      allow create: if signedIn() && validTrafficId() && trafficShape()
        && request.resource.data.n == 1 && request.resource.data.s >= 0 && request.resource.data.s <= 200
        && request.resource.data.exp > request.time && request.resource.data.exp <= request.time + duration.value(2400, 's');
      allow update: if signedIn() && validTrafficId() && trafficShape()
        && request.resource.data.n == resource.data.n + 1 && request.resource.data.n <= 2000
        && request.resource.data.s >= resource.data.s && request.resource.data.s <= resource.data.s + 200
        && request.resource.data.exp == resource.data.exp;
      allow delete: if false;   // dihapus otomatis oleh kebijakan TTL pada field exp
    }

    match /reports/{id} {
      // get = satu dokumen (memilih laporan untuk dinilai); list = kueri geohash — wajib memakai limit ≤ 200 (melindungi kuota baca)
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 200;

      function validNew() {
        let d = request.resource.data;
        return d.keys().hasOnly(['type', 'lat', 'lng', 'geohash', 'createdAt', 'expiresAt', 'severity', 'note', 'uid', 'confirms', 'denies', 'abuse'])
          && d.keys().hasAll(['type', 'lat', 'lng', 'geohash', 'createdAt', 'expiresAt', 'severity', 'uid', 'confirms', 'denies', 'abuse'])
          && validType(d.type)
          && d.lat is number && d.lat >= -90 && d.lat <= 90 && d.lng is number && d.lng >= -180 && d.lng <= 180
          && d.geohash is string && d.geohash.size() == 9
          && d.createdAt == request.time
          && d.expiresAt is timestamp && d.expiresAt > request.time && d.expiresAt <= request.time + duration.value(ttlTable()[d.type], 's')
          && d.severity is int && d.severity >= 1 && d.severity <= 3
          && (!('note' in d) || (d.note is string && d.note.size() <= 100))
          && d.uid == request.auth.uid
          && d.confirms == 0 && d.denies == 0 && d.abuse == 0;
      }
      allow create: if signedIn() && validNew()
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.lastReportAt == request.time;   // wajib satu batch dengan profil anti-spam

      // Pembaruan = SATU suara: penghitung naik 1 dan dokumen votes/{uid} dibuat dalam batch yang sama. Tidak boleh memilih laporan sendiri.
      function voteAfter() { return getAfter(/databases/$(db)/documents/reports/$(id)/votes/$(request.auth.uid)).data; }
      allow update: if signedIn() && resource.data.uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirms', 'denies', 'abuse', 'expiresAt'])
        && !exists(/databases/$(db)/documents/reports/$(id)/votes/$(request.auth.uid))
        && (
          (voteAfter().v == 1
            && request.resource.data.confirms == resource.data.confirms + 1
            && request.resource.data.denies == resource.data.denies && request.resource.data.abuse == resource.data.abuse
            && request.resource.data.expiresAt >= resource.data.expiresAt
            && request.resource.data.expiresAt <= resource.data.expiresAt + duration.value(ttlQuarterTable()[resource.data.type], 's')
            && request.resource.data.expiresAt <= resource.data.createdAt + duration.value(ttlTable()[resource.data.type] * 2, 's'))
          ||
          (voteAfter().v == -1
            && request.resource.data.denies == resource.data.denies + 1
            && request.resource.data.confirms == resource.data.confirms && request.resource.data.abuse == resource.data.abuse
            && request.resource.data.expiresAt == resource.data.expiresAt)
          ||
          (voteAfter().v == 2
            && request.resource.data.abuse == resource.data.abuse + 1
            && request.resource.data.confirms == resource.data.confirms && request.resource.data.denies == resource.data.denies
            && request.resource.data.expiresAt == resource.data.expiresAt)
        );

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;      // hanya pemilik

      match /votes/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(db)/documents/reports/$(id))                  // tidak ada suara untuk laporan fiktif
          && request.resource.data.keys().hasOnly(['v', 'at'])
          && request.resource.data.keys().hasAll(['v', 'at'])
          && request.resource.data.v in [1, -1, 2]
          && request.resource.data.at == request.time;
        allow update: if false;
        // Suara hanya boleh dihapus bila laporan induknya sudah tidak ada (hak hapus data; mencegah suara ganda)
        allow delete: if signedIn() && request.auth.uid == uid && !exists(/databases/$(db)/documents/reports/$(id));
      }
    }
  }
}
